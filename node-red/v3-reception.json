        "name": "ingest · uplink",
        "func": "const ing = global.get(\"ingest\");\nif (!ing) { msg.statusCode = 503; msg.payload = \"\"; return msg; }   // V3 pas encore configurée\nconst r = await ing.recevoirUplink(msg.payload, msg.req.headers);\nmsg.statusCode = r.statut;\nmsg.payload = \"\";\nnode.send(msg);                                   // réponse à TTS tout de suite (< 5 s)\nif (r.suite) r.suite().catch(e => node.error(`$uplink : ${e.message}`));\nreturn null;",
