    {
        "id": "c0de5ec0e7b3000d",
        "type": "function",
        "z": "c0de5ec0e7b30000",
        "name": "santé",
        "func": "const ing = global.get(\"ingest\");\nif (!ing) { msg.statusCode = 503; msg.payload = \"\"; return msg; }   // V3 pas encore configurée\nif (!require_secret()) return null;\nmsg.payload = ing.sante();\nmsg.statusCode = 200;\nreturn msg;\nfunction require_secret() {\n    const s = env.get(\"TTN_WEBHOOK_SECRET\");\n    if (s && (msg.req.headers[\"x-mobilab-secret\"] || \"\") === s) return true;\n    msg.statusCode = 401; msg.payload = \"\"; node.send(msg); return false;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
