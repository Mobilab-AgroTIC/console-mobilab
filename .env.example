# Console Mobilab : copier en .env et remplacer chaque valeur. Jamais de vrai secret ici.
TIMEZONE=Europe/Paris

# Postgres (superutilisateur, utilisé seulement par l'initialisation et la commande migrate)
POSTGRES_USER=mobilab
POSTGRES_PASSWORD=changer-moi
# Comptes techniques V3 (posés par : docker compose --profile outils run --rm mobilab-migrate)
PG_SVC_NODERED_PASSWORD=changer-moi
PG_SVC_CONSOLE_PASSWORD=changer-moi
PG_OWNER_PASSWORD=

# Node-RED (hash bcrypt : node-red admin hash-pw)
NR_ADMIN_USER=admin
NR_ADMIN_PASS_HASH=$2b$08$remplacer-par-le-hash
NR_CREDENTIAL_SECRET=changer-moi

# Grafana (compte administrateur serveur, aussi utilisé par le service console)
GRAFANA_USER=admin
GRAFANA_PASSWORD=changer-moi
# Logins Grafana de l'équipe, mis Admin de chaque ferme (séparés par des virgules)
MOBILAB_STAFF_LOGINS=
# SMTP facultatif
GF_SMTP_ENABLED=false
GF_SMTP_HOST=
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=

# The Things Stack
TTN_HOST=ttn.lapibole.fr
TTN_ORG_ID=mobilab
# Clé API de l'organisation (créer, lister les applications, tous les droits dessus)
TTN_API_KEY=NNSXS.remplacer
TTN_FREQUENCY_PLAN=EU_863_870_TTN
# En-tête X-Mobilab-Secret des webhooks ; l'ancien reste accepté pendant un changement
TTN_WEBHOOK_SECRET=changer-moi
TTN_WEBHOOK_SECRET_PREVIOUS=

# Service console V3
# Chiffrement des AppKey en attente : openssl rand -hex 32
SECRETS_KEY=
TELEGRAM_CLIENT_BOT_TOKEN=
TELEGRAM_ADMIN_BOT_TOKEN=
# Ids Telegram des admins permanents (séparés par des virgules)
ADMIN_BOOTSTRAP_IDS=

PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=