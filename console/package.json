    "pg": "8.13.1",
    "qrcode": "1.5.4",
    "yaml": "2.6.1"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/pdfkit": "0.13.5",
    "@types/pg": "8.11.10",
    "@types/qrcode": "1.5.5",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
